# Shared database settings (postgres + litellm)
DB_USER=llmproxy
DB_PASSWORD=
DB_NAME=llmproxy
DB_HOST=llmproxy-data_db

# LiteLLM component
LITELLM_HOST=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_LICENSE=
SLACK_WEBHOOK_URL=
LITELLM_LOGGER_S3_BUCKET=
LITELLM_LOGGER_S3_REGION=
LITELLM_LOGGER_S3_PATH=
LITELLM_LOGGER_AWS_ACCESS_KEY_ID=
LITELLM_LOGGER_AWS_SECRET_ACCESS_KEY=
CLAUDE_CODE_MODELS=claude-*
CLAUDE_CODE_MIN_VERSION=2.1.140
LITELLM_DISABLE_NO_REDIS_WARNING=true
LITELLM_VISION_MODEL_ROUTER_MODELS=anthropic/a-0,anthropic/a-1,anthropic/a-2,openai/o-0,openai/o-1,openai/o-2

# Shared Traefik integration defaults
TRAEFIK_ROUTER_ENTRYPOINTS=websecure
TRAEFIK_ROUTER_TLS=true
LETSENCRYPT_RESOLVER=le

# Portainer component (required only by the independent portainer preset)
PORTAINER_HOST=portainer.example.com

# Cloudflare API token for the Let's Encrypt DNS challenge.
# Create at https://dash.cloudflare.com/profile/api-tokens with Zone:DNS:Edit permission.
CF_DNS_API_TOKEN=
LETSENCRYPT_EMAIL=

# Monitoring / Netdata component (required only by all or --stack monitoring)
NETDATA_HOST=
# Generate with: htpasswd -nb admin '<password>'
# Escape literal $ as $$ when used in Docker Compose labels.
NETDATA_BASIC_AUTH=

# Headroom component + Traefik overlay (required only by llmproxy/all)
HEADROOM_HOST=
HEADROOM_API_KEY=
HEADROOM_BASIC_AUTH=
HEADROOM_TELEMETRY=on
HEADROOM_COMPRESS_USER_MESSAGES=1
HEADROOM_COMPRESS_ALLOW_REMOTE=1

# CLIProxyAPI components + Traefik overlay (required only by llmproxy/all)
CLI_PROXY_API_HOST=
CLI_PROXY_API_MANAGEMENT_KEY=
CLI_PROXY_API_USAGE_HOST=
CLI_PROXY_API_USAGE_LOGIN_PASSWORD=
CLI_PROXY_API_USAGE_AUTH_ENABLED=true
