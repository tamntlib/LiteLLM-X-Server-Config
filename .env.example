DB_USER=llmproxy
DB_PASSWORD=
DB_NAME=llmproxy
DB_HOST=llmproxy-data_db

LITELLM_HOST=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_LICENSE=
SLACK_WEBHOOK_URL=

LITELLM_LOGGER_S3_BUCKET=
LITELLM_LOGGER_S3_REGION=
LITELLM_LOGGER_S3_PATH=
LITELLM_LOGGER_AWS_ACCESS_KEY_ID=
LITELLM_LOGGER_AWS_SECRET_ACCESS_KEY=

CLAUDE_CODE_MODELS=claude-*
CLAUDE_CODE_MIN_VERSION=2.1.140
LITELLM_VISION_MODEL_ROUTER_MODELS=anthropic/a-0,anthropic/a-1,anthropic/a-2,openai/o-0,openai/o-1,openai/o-2

# Public dashboard hostname. Create a DNS record pointing it to Traefik.
HEADROOM_HOST=
# Shared by LiteLLM and Traefik -> Headroom. A raw value is stored in Docker labels.
# Prefer a token without "$", for example: openssl rand -hex 32
HEADROOM_API_KEY=
# Generate with: htpasswd -nb admin '<password>'
HEADROOM_BASIC_AUTH=
HEADROOM_TELEMETRY=on
HEADROOM_COMPRESS_USER_MESSAGES=1
HEADROOM_COMPRESS_ALLOW_REMOTE=1

CLI_PROXY_API_HOST=
CLI_PROXY_API_MANAGEMENT_KEY=
CLI_PROXY_API_USAGE_HOST=
CLI_PROXY_API_USAGE_LOGIN_PASSWORD=

# Default Traefik router mode for the application stack.
# Uses HTTPS with Let's Encrypt via Cloudflare DNS challenge.
TRAEFIK_ROUTER_ENTRYPOINTS=websecure
TRAEFIK_ROUTER_TLS=true
LETSENCRYPT_RESOLVER=le
