{
    "$schema": "./config.schema.json",
    "providers": {
        "cli-proxy-api": {
            "api_base": "http://cli-proxy-api:8317",
            "models_autofill_disabled": true,
            "access_groups": [
                "General"
            ],
            "interfaces": {
                "anthropic": {
                    "models": {
                        "a-0": {},
                        "a-0-vision": {},
                        "a-1": {},
                        "a-1-vision": {},
                        "a-2": {},
                        "a-2-vision": {}
                    }
                },
                "openai": {
                    "models": {
                        "o-0": {},
                        "o-0-vision": {},
                        "o-1": {},
                        "o-1-vision": {},
                        "o-2": {},
                        "o-2-vision": {},
                        "gpt-image-2": {},
                        "codex-auto-review": {}
                    }
                }
            }
        }
    },
    "public_model_hub_aliases_autofill_disabled": true,
    "model_name_base_model_map": {
        "a-0": "gpt-5.6-sol",
        "a-0-vision": "gpt-5.6-sol",
        "a-1": "gpt-5.6-terra",
        "a-1-vision": "gpt-5.6-terra",
        "a-2": "gpt-5.6-luna",
        "a-2-vision": "gpt-5.6-luna",
        "o-0": "gpt-5.6-sol",
        "o-0-vision": "gpt-5.6-sol",
        "o-1": "gpt-5.6-terra",
        "o-1-vision": "gpt-5.6-terra",
        "o-2": "gpt-5.6-luna",
        "o-2-vision": "gpt-5.6-luna"
    },
    "guardrails": {
        "headroom-compression": {
            "litellm_params": {
                "guardrail": "headroom",
                "mode": "pre_call",
                "default_on": true,
                "api_base": "http://headroom:8787",
                "unreachable_fallback": "fail_open"
            },
            "guardrail_info": {
                "description": "Global Headroom prompt compression"
            }
        }
    },
    "aliases": {
        "claude-fable-*": "anthropic/a-0",
        "claude-opus-*": "anthropic/a-0",
        "claude-sonnet-*": "anthropic/a-1",
        "claude-haiku-*": "anthropic/a-2",
        "gpt-*": "openai/o-0",
        "gpt-*-sol": "openai/o-0",
        "gpt-*-terra": "openai/o-1",
        "gpt-*-luna": "openai/o-2",
        "gpt-image-*": "openai/gpt-image-2",
        "codex-auto-review": "openai/codex-auto-review"
    },
    "router_settings": {
        "cooldown_time": 0,
        "num_retries": 1,
        "timeout": 600
    }
}