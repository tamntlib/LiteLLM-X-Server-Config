{
    "$schema": "./config.schema.json",
    "providers": {
        "cli-proxy-api": {
            "api_base": "http://cli-proxy-api:8317",
            "models_autofill_disabled": true,
            "access_groups": [
                "General"
            ],
            "default_model": {
                "model_info": {
                    "max_input_tokens": 272000
                }
            },
            "models": {
                "primary": {},
                "primary-vision": {},
                "secondary": {},
                "secondary-vision": {},
                "tertiary": {},
                "tertiary-vision": {},
                "gpt-5.5": {},
                "gpt-5.4": {},
                "gpt-5.4-mini": {}
            },
            "interfaces": {
                "anthropic": {},
                "openai": {
                    "models": {
                        "gpt-image-2": {
                            "model_info": {
                                "$delete": [
                                    "max_input_tokens"
                                ]
                            }
                        },
                        "codex-auto-review": {
                            "model_info": {
                                "$delete": [
                                    "max_input_tokens"
                                ]
                            }
                        }
                    }
                }
            }
        }
    },
    "public_model_hub_aliases_autofill_disabled": true,
    "model_name_base_model_map": {
        "primary": "gpt-5.6-sol",
        "primary-vision": "gpt-5.6-sol",
        "secondary": "gpt-5.6-terra",
        "secondary-vision": "gpt-5.6-terra",
        "tertiary": "gpt-5.6-luna",
        "tertiary-vision": "gpt-5.6-luna"
    },
    "guardrails": {
        "headroom-compression": {
            "litellm_params": {
                "guardrail": "headroom",
                "mode": "pre_call",
                "default_on": true,
                "api_base": "http://headroom:8787",
                "unreachable_fallback": "fail_open"
            },
            "guardrail_info": {
                "description": "Global Headroom prompt compression"
            }
        }
    },
    "aliases": {
        "claude-fable-*": "anthropic/primary",
        "claude-opus-*": "anthropic/primary",
        "claude-sonnet-*": "anthropic/secondary",
        "claude-haiku-*": "anthropic/tertiary",
        "gpt-*": "openai/primary",
        "gpt-*-sol": "openai/primary",
        "gpt-*-terra": "openai/secondary",
        "gpt-*-luna": "openai/tertiary",
        "gpt-*-mini": "openai/gpt-5.4-mini",
        "gpt-image-*": "openai/gpt-image-2",
        "codex-auto-review": "openai/codex-auto-review"
    },
    "fallbacks": [
        {
            "$interface/primary": [
                "$interface/secondary",
                "$interface/tertiary"
            ]
        },
        {
            "$interface/secondary": [
                "$interface/primary",
                "$interface/tertiary"
            ]
        },
        {
            "$interface/tertiary": [
                "$interface/primary",
                "$interface/secondary"
            ]
        },
        {
            "$interface/primary-vision": [
                "$interface/secondary-vision",
                "$interface/tertiary-vision"
            ]
        },
        {
            "$interface/secondary-vision": [
                "$interface/primary-vision",
                "$interface/tertiary-vision"
            ]
        },
        {
            "$interface/tertiary-vision": [
                "$interface/primary-vision",
                "$interface/secondary-vision"
            ]
        }
    ],
    "router_settings": {
        "cooldown_time": 0,
        "num_retries": 1,
        "timeout": 600
    }
}